# R curve catalogues (hsr/data/sources/<name>_curves.csv) and the R packages
# whose implementations verify them
CURVE_CATALOGUES = {"thermal": "rTPC,devRate,photosynthesis",
                    "ecocurves": "sars,nlsMicrobio,growthrates,FSA,growthmodels,fitplc,photosynthesis,DoseFinding"}
# R files sourced from CRAN source tarballs (packages not installed; versions in config.cran_sources)
CURVE_SOURCED = {"thermal": [], "ecocurves": [("bayesnec", "bayesnec/R/pred_equations.R")]}


def _cran_tarball(pkg):
    return f"results/corpora/raw/cran_{pkg}/{pkg}_{config['cran_sources'][pkg]}.tar.gz"


rule cran_source_fetch:
    """A CRAN source tarball (version in config.cran_sources), with its sha256."""
    output:
        "results/corpora/raw/cran_{pkg}/manifest.json",
    params:
        raw="results/corpora/raw/cran_{pkg}",
        version=lambda wc: config["cran_sources"][wc.pkg],
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py cran_fetch {params.raw} {wildcards.pkg} {params.version}"


rule rcurves_eval:
    """Evaluate the package implementations of a curve catalogue's rows at
    random parameters (per-row ranges); package versions are written alongside."""
    input:
        src="hsr/data/sources/{cat}_curves.csv",
        code="workflow/scripts/rcurves_eval.R",
        sourced=lambda wc: [f"results/corpora/raw/cran_{p}/manifest.json" for p, _ in CURVE_SOURCED[wc.cat]],
    output:
        csv="results/corpora/{cat}_eval.csv",
        versions="results/corpora/{cat}_eval.csv.versions",
    wildcard_constraints:
        cat="|".join(CURVE_CATALOGUES),
    params:
        rlib=config.get("r_lib", ""),
        pkgs=lambda wc: CURVE_CATALOGUES[wc.cat],
        sourced=lambda wc: ",".join(f"{_cran_tarball(p)}::{m}" for p, m in CURVE_SOURCED[wc.cat]),
    shell:
        "Rscript workflow/scripts/rcurves_eval.R {input.src} {output.csv} '{params.rlib}' {params.pkgs} '{params.sourced}'"


rule rcurves_corpus:
    """Verified, canonicalised corpus of a curve catalogue, one model per original publication (committed)."""
    input:
        src="hsr/data/sources/{cat}_curves.csv",
        ev="results/corpora/{cat}_eval.csv",
        code=["hsr/corpus_sources.py", "hsr/corpus.py", "hsr/canonical.py", "hsr/grammar_compare.py"],
    output:
        "hsr/data/corpus_{cat}.json",
    wildcard_constraints:
        cat="|".join(CURVE_CATALOGUES),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py curves_build {input.src} {input.ev} {output}"


rule r_env_versions:
    """Versions of R and the packages of the pinned R environment (envs/r.yaml)."""
    output:
        "results/corpora/r_env_versions.txt",
    conda:
        "envs/r.yaml"
    shell:
        "Rscript -e 'ip <- installed.packages(); writeLines(paste(c(\"R\", ip[, \"Package\"]), "
        "c(paste(R.version$major, R.version$minor, sep = \".\"), ip[, \"Version\"]), sep = \"=\"), \"{output}\")'"


# hold-out sources (config holdout_sources): built here, never used for training
include: "rules/rnls.smk"
include: "rules/ratelaws.smk"
include: "rules/ecocat2.smk"


LOSO = ["biomodels", "sabiork", "cellml", "curvelib", "biocat", "biomodels_nc", "thermal", "ecocurves", "modeldb",
        "nlmixr2lib", "allodb", "jws"]
NEW_CORPORA = ["biomodels_nc", "thermal", "ecocurves", "modeldb", "nlmixr2lib", "allodb", "jws"]


rule corpus_overlap:
    """Models, forms, forms new relative to the original five sources, and pairwise shared forms."""
    input:
        gen="results/grammar/generalised.json",
        corpora=expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"] + NEW_CORPORA) + ["hsr/data/corpus.json"],
        code="hsr/corpus_sources.py",
    output:
        "results/corpora/overlap.md",
    params:
        named=" ".join(f"{n}=" + ("hsr/data/corpus.json" if n == "biomodels" else f"hsr/data/corpus_{n}.json") for n in LOSO),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py overlap_report {input.gen} {output} "
        "biomodels,sabiork,cellml,curvelib,biocat {params.named}"


rule loso_folds:
    """Leave one corpus out: train priors on the other sources (pooled or
    equally weighted), score the left-out source."""
    input:
        gen="results/grammar/generalised.json",
        corpora=expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"] + NEW_CORPORA) + ["hsr/data/corpus.json"],
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/loso_{test}_{weighting}/folds.json",
    wildcard_constraints:
        weighting="pooled|equal",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py loso {input.gen} {wildcards.test} "
        "{wildcards.weighting} {output}"


rule loso_table:
    input:
        expand("results/grammar/loso_{test}_{weighting}/table.md", test=LOSO, weighting=["pooled", "equal"]),
    output:
        "results/grammar/loso.md",
    shell:
        "for f in {input}; do echo \"## $(dirname $f | xargs basename)\"; cat $f; echo; done > {output}"


rule transfer_folds:
    input:
        gen="results/grammar/generalised.json",
        test="hsr/data/corpus_{name}.json",
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/transfer_{name}/folds.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py transfer {input.gen} {input.test} {output}"


rule biomodels_corpus:
    """BioModels kinetic-law corpus (hsr.corpus). EBI blocks GitHub-hosted
    runners, so this runs locally; downloads are cached under
    results/corpora/raw/biomodels and a manifest (sha256 per model) is written."""
    output:
        corpus="hsr/data/corpus.json",
        manifest="results/corpora/raw/biomodels/MANIFEST.json",
    params:
        cache="results/corpora/raw/biomodels",
        first=config.get("biomodels_first", 1),
        last=config.get("biomodels_last", 1100),
    conda:
        "envs/biomodels.yaml"
    shell:
        "PYTHONPATH={ROOT} python -m hsr.corpus build --out {output.corpus} --first {params.first} "
        "--last {params.last} --cache {params.cache} && "
        "PYTHONPATH={ROOT} python workflow/scripts/manifest.py {params.cache} {output.manifest}"


rule corpus_generalised:
    """Literal-free form of every corpus key, shipped with the package (used by --prior fnprior)."""
    input:
        corpus="hsr/data/corpus.json",
        code=["hsr/grammar_compare.py", "hsr/canonical.py", "hsr/fixed_prior.py"],
    output:
        "hsr/data/corpus_generalised.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python -c 'from hsr.fixed_prior import build_generalised; build_generalised()'"


rule generalised:
    """Literal-free generalisation of every corpus and candidate form (slow: sympy)."""
    input:
        corpus="hsr/data/corpus.json",
        candidates="hsr/data/candidates.json",
        code=["hsr/canonical.py"],
    output:
        "results/grammar/generalised.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py generalised {output}"


rule folds:
    input:
        gen="results/grammar/generalised.json",
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/seed{seed}/folds.json",
    params:
        k=GC["k"],
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py folds {input.gen} {output} {params.k} {wildcards.seed}"


rule grammar_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        code="hsr/grammar_compare.py",
    output:
        "results/grammar/{run}/ours.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py ours {input.folds} {output}"


rule fnprior_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        code="workflow/scripts/fnprior_score.py",
    output:
        "results/grammar/{run}/fnprior.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/fnprior_score.py {input.folds} {output}"


rule hpy_scores:
    """Hierarchical Pitman-Yor model (hsr.hpy) on fnprior's tree events."""
    input:
        folds="results/grammar/{run}/folds.json",
        code=["workflow/scripts/hpy_score.py", "hsr/hpy.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/{run}/hpy.json",
    params:
        sweeps=config.get("hpy_sweeps", 20),
        keep=config.get("hpy_keep", 10),
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpy_score.py {input.folds} {output} {params.sweeps} {params.keep}"


rule grammar_table_run:
    input:
        folds="results/grammar/{run}/folds.json",
        ours="results/grammar/{run}/ours.json",
        fnp="results/grammar/{run}/fnprior.json",
        hpy="results/grammar/{run}/hpy.json",
    output:
        json="results/grammar/{run}/table.json",
        md="results/grammar/{run}/table.md",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py table {input.folds} {output.json} {output.md} "
        "{input.ours} {input.fnp} {input.hpy}"


rule grammar_table:
    input:
        expand("results/grammar/seed{seed}/table.md", seed=SEEDS),
    output:
        "results/grammar/table.md",
    shell:
        "for f in {input}; do echo \"## $(dirname $f | xargs basename)\"; cat $f; echo; done > {output}"


# ------------------------------------------- tree-prior variants (hpyv_*)
# Graphical/hierarchical Pitman-Yor priors and subtree adaptors over
# fnprior's tree coding (hsr.pyp, hsr.adaptor), scored on every comparison
# run both renormalised over the support and as raw log P(tree).
#
#     snakemake --use-conda --cores 4 hpyv
HPYV = config["hpyv"]
# variants to run: config hpyv.run (a subset, by name) or all defined variants
HPYV_VARIANTS = list(HPYV.get("run") or HPYV["variants"])
HPYV_RUNS = ([f"seed{s}" for s in SEEDS] + [f"transfer_{n}" for n in TRANSFER]
             + [f"loso_{t}_{w}" for t in LOSO for w in ("pooled", "equal")])
HPYV_CODE = ["hsr/treecode.py", "hsr/pyp.py", "hsr/adaptor.py", "hsr/treecheck.py", "hsr/fnprior_tools.py"]


def _hpyv_trees(wc):
    """Hold-out runs have their own tree file (their support adds the hold-out forms)."""
    if wc.run.startswith("holdout_"):
        return "results/grammar/hpyv/trees_holdout.json"
    if wc.run.startswith("mechholdout_"):
        return "results/grammar/hpyv/trees_mech.json"
    return "results/grammar/hpyv/trees.json"


rule hpyv:
    input:
        "results/grammar/hpy_variants.md",


rule hpyv_variant:
    """One variant's settings (from config) as a file, so that scores depend on it."""
    output:
        "results/grammar/hpyv/variants/{v}.json",
    params:
        spec=lambda wc: HPYV["variants"].get(wc.v, {}),
    run:
        import json
        with open(output[0], "w") as fh:
            json.dump({"name": wildcards.v, **params.spec}, fh, indent=1)


rule hpyv_trees:
    """Every support form coded as a tree (hsr.treecode); checks the events against fnprior's own coding."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=HPYV_RUNS),
        code=["workflow/scripts/hpyv_trees.py", "hsr/treecode.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/hpyv/trees.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_trees.py {output} {input.folds}"


rule hpyv_sources:
    """Model-form pairs of every corpus source (labels for the source-level hierarchy)."""
    input:
        gen="results/grammar/generalised.json",
        corpora=expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"]) + ["hsr/data/corpus.json"],
        code=["workflow/scripts/hpyv_sources.py", "hsr/grammar_compare.py"],
    output:
        "results/grammar/hpyv/sources.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_sources.py {input.gen} {output}"


rule hpyv_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        trees=_hpyv_trees,
        sources="results/grammar/hpyv/sources.json",
        variant="results/grammar/hpyv/variants/{v}.json",
        code=["workflow/scripts/hpyv_score.py"] + HPYV_CODE,
    output:
        "results/grammar/{run}/hpyv_{v}.json",
    wildcard_constraints:
        run="[^/]+",
    params:
        sweeps=HPYV["sweeps"],
        keep=HPYV["keep"],
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_score.py {input.folds} {input.trees} {input.sources} {input.variant} {output} "
        "{params.sweeps} {params.keep}"


rule hpyv_table_run:
    input:
        folds="results/grammar/{run}/folds.json",
        trees=_hpyv_trees,
        ours="results/grammar/{run}/ours.json",
        fnp="results/grammar/{run}/fnprior.json",
        hpy="results/grammar/{run}/hpy.json",
        v=expand("results/grammar/{{run}}/hpyv_{v}.json", v=HPYV_VARIANTS),
        code="workflow/scripts/hpyv_table.py",
    output:
        json="results/grammar/{run}/table_v.json",
        md="results/grammar/{run}/table_v.md",
    wildcard_constraints:
        run="[^/]+",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_table.py {input.folds} {input.trees} {output.json} {output.md} "
        "{input.ours} {input.fnp} {input.hpy} {input.v}"


rule hpyv_calib:
    """Size calibration and properness of a prior trained on all BioModels forms (forward samples)."""
    input:
        folds="results/grammar/transfer_sabiork/folds.json",
        trees="results/grammar/hpyv/trees.json",
        variant="results/grammar/hpyv/variants/{v}.json",
        code=["workflow/scripts/hpyv_calib.py"] + HPYV_CODE,
    output:
        "results/grammar/hpyv/calib_{v}.json",
    params:
        sweeps=HPYV["sweeps"],
        keep=HPYV["keep"],
        n=HPYV["calib_samples"],
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_calib.py {input.folds} {input.trees} {input.variant} {output} "
        "{params.sweeps} {params.keep} {params.n}"


rule hpyv_report:
    input:
        tables=expand("results/grammar/{run}/table_v.json", run=HPYV_RUNS),
        scores=expand("results/grammar/{run}/hpyv_{v}.json", run=HPYV_RUNS, v=HPYV_VARIANTS),
        calib=expand("results/grammar/hpyv/calib_{v}.json", v=HPYV_VARIANTS + ["fnprior_kn"]),
        trees="results/grammar/hpyv/trees.json",
        notes="workflow/notes/hpy_variants.md",
        code="workflow/scripts/hpyv_report.py",
    output:
        "results/grammar/hpy_variants.md",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_report.py {output} {input.trees} --notes {input.notes} "
        "--tables {input.tables} --scores {input.scores} --calib {input.calib}"


# ------------------------------------------------------------ hold-outs
# Every prior trained on all twelve training sources (LOSO list; equal or
# pooled weighting) and scored on the hold-out sources of config
# holdout_sources, which never enter any training set. One run per
# weighting: the training data are the same for every hold-out, so the
# per-source tables of holdout.md split one set of scores.
#
#     snakemake --use-conda --cores 2 --rerun-triggers=mtime holdout \
#         --allowed-rules holdout_folds hpyv_trees_holdout hpyv_sources hpyv_variant grammar_scores \
#             fnprior_scores hpy_scores hpyv_scores hpyv_table_run holdout_report holdout
#
# (--allowed-rules uses the committed corpus files as they are, without
# rebuilding them from the raw caches; 2 cores: adaptor scoring is memory-hungry.)
HOLDOUTS = config.get("holdout_sources", [])
HOLDOUT_RUNS = [f"holdout_{w}" for w in ("equal", "pooled")]
TRAIN_CORPORA = expand("hsr/data/corpus_{n}.json", n=[n for n in LOSO if n != "biomodels"]) + ["hsr/data/corpus.json"]


rule holdout_folds:
    """Train on every training source (weighted), test on every hold-out source."""
    input:
        gen="results/grammar/generalised.json",
        corpora=TRAIN_CORPORA,
        holdouts=expand("hsr/data/corpus_{n}.json", n=HOLDOUTS),
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/holdout_{weighting}/folds.json",
    wildcard_constraints:
        weighting="pooled|equal",
    params:
        named=" ".join(f"{n}=hsr/data/corpus_{n}.json" for n in HOLDOUTS),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py holdout {input.gen} {wildcards.weighting} "
        "{output} {params.named}"


rule hpyv_trees_holdout:
    """Tree coding (as hpyv_trees) of every support form of the hold-out runs."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=HOLDOUT_RUNS),
        code=["workflow/scripts/hpyv_trees.py", "hsr/treecode.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/hpyv/trees_holdout.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_trees.py {output} {input.folds}"


rule holdout_report:
    input:
        folds=expand("results/grammar/{run}/folds.json", run=HOLDOUT_RUNS),
        tables=expand("results/grammar/{run}/table_v.json", run=HOLDOUT_RUNS),
        trees="results/grammar/hpyv/trees_holdout.json",
        code="workflow/scripts/holdout_report.py",
    output:
        md="results/grammar/holdout.md",
        json="results/grammar/holdout.json",
    params:
        runs=" ".join(f"results/grammar/{r}" for r in HOLDOUT_RUNS),
        variants=" ".join(HPYV_VARIANTS),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/holdout_report.py {output.md} {output.json} {input.trees} "
        "{params.runs} --variants {params.variants}"


rule holdout:
    input:
        "results/grammar/holdout.md",


# ============================================ mechanism-derived forms (test 4)
# Forms derived from random mechanisms (hsr.mechanisms; classes enzyme,
# compartment, temperature; config mechanisms), scored as hold-outs exactly
# as the hold-out sources: every prior trained on all training sources and
# scored on one run whose test set is the hold-out sources plus every
# mechanism class (runs mechholdout_<weighting>; the support of these runs is
# also the candidate set of the look-alike test).
#
#     snakemake --use-conda --cores 1 --rerun-triggers=mtime mechanisms \
#         --allowed-rules mechanism_forms mechholdout_folds hpyv_trees_mech hpyv_sources hpyv_variant \
#             grammar_scores fnprior_scores hpy_scores hpyv_scores hpyv_table_run mechanisms_report \
#             mechanism_forms_report mechanisms
MECH = config["mechanisms"]
MECH_CLASSES = list(MECH["n"])
MECH_NAMES = [f"mech_{c}" for c in MECH_CLASSES]
MECH_RUNS = [f"mechholdout_{w}" for w in ("equal", "pooled")]


rule mechanisms:
    input:
        "results/grammar/mechanisms.md",
        "results/grammar/mechanism_forms.md",


rule mechanism_forms:
    """Corpus-style JSON (per_model, freq, records, drop counts) of the forms
    of n random mechanisms of one class (committed)."""
    input:
        code="hsr/mechanisms.py",
    output:
        "hsr/data/corpus_mech_{cls}.json",
    wildcard_constraints:
        cls="|".join(MECH_CLASSES),
    params:
        n=lambda wc: MECH["n"][wc.cls],
        seed=MECH["seed"],
        max_consts=MECH["max_consts"],
        max_terms=MECH["max_terms"],
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python -m hsr.mechanisms --class {wildcards.cls} --n {params.n} --seed {params.seed} "
        "--max-consts {params.max_consts} --max-terms {params.max_terms} --out {output}"


rule mechholdout_folds:
    """As holdout_folds, with the mechanism classes as further hold-outs."""
    input:
        gen="results/grammar/generalised.json",
        corpora=TRAIN_CORPORA,
        holdouts=expand("hsr/data/corpus_{n}.json", n=HOLDOUTS + MECH_NAMES),
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/mechholdout_{weighting}/folds.json",
    wildcard_constraints:
        weighting="pooled|equal",
    params:
        named=" ".join(f"{n}=hsr/data/corpus_{n}.json" for n in HOLDOUTS + MECH_NAMES),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py holdout {input.gen} {wildcards.weighting} "
        "{output} {params.named}"


rule hpyv_trees_mech:
    """Tree coding (as hpyv_trees) of every support form of the mechanism hold-out runs."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=MECH_RUNS),
        code=["workflow/scripts/hpyv_trees.py", "hsr/treecode.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/hpyv/trees_mech.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_trees.py {output} {input.folds}"


rule mechanisms_report:
    """holdout_report on the mechanism hold-out runs (hold-out sources and mechanism classes)."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=MECH_RUNS),
        tables=expand("results/grammar/{run}/table_v.json", run=MECH_RUNS),
        trees="results/grammar/hpyv/trees_mech.json",
        code="workflow/scripts/holdout_report.py",
    output:
        md="results/grammar/mechanisms.md",
        json="results/grammar/mechanisms.json",
    params:
        runs=" ".join(f"results/grammar/{r}" for r in MECH_RUNS),
        variants=" ".join(HPYV_VARIANTS),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/holdout_report.py {output.md} {output.json} {input.trees} "
        "{params.runs} --variants {params.variants} --title 'Mechanism-derived forms as hold-outs' "
        "--target mechanisms"


rule mechanism_forms_report:
    """Forms of each mechanism class: frequency, constants, and whether the
    form occurs in the training sources."""
    input:
        corpora=expand("hsr/data/corpus_{n}.json", n=MECH_NAMES),
        folds="results/grammar/mechholdout_equal/folds.json",
        code="workflow/scripts/mechanism_report.py",
    output:
        "results/grammar/mechanism_forms.md",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/mechanism_report.py {output} {input.folds} {input.corpora}"


# ======================================== look-alike discrimination test (lookalike_*)
# When the data barely distinguish candidate forms, does the prior put its
# mass on the true one? hsr.lookalike (design and scores; config lookalike).
# The design (true forms, simulated datasets, candidate set) is built locally
# and committed; the evidence shards run on GitHub Actions
# (.github/workflows/lookalike.yml; runners only run lookalike_shard on the
# committed design); their artifacts are downloaded to results/lookalike/shards
# and the report is built locally:
#
#     snakemake --use-conda --cores 1 --rerun-triggers=mtime results/lookalike/design.json \
#         --allowed-rules lookalike_design
#     gh workflow run lookalike.yml --ref lookalike    # then gh run download <id> -D results/lookalike/shards
#     snakemake --use-conda --cores 1 --rerun-triggers=mtime lookalike \
#         --allowed-rules lookalike_report lookalike
LA = config["lookalike"]
LA_SHARDS = [f"results/lookalike/shards/{i}of{LA['shards']}.npz" for i in range(LA["shards"])]
LA_TRUN = f"temporal_{LA['temporal_cutoff']}_equal"


rule lookalike:
    input:
        "results/grammar/lookalike.md",


rule lookalike_design:
    """True forms, simulated datasets and candidate set (committed; the runners' input)."""
    input:
        mech="results/grammar/mechholdout_equal/folds.json",
        temporal=f"results/grammar/{LA_TRUN}/folds.json",
        trees="results/grammar/hpyv/trees_mech.json",
        code=["hsr/lookalike.py", "hsr/simulate.py", "workflow/scripts/lookalike_steps.py"],
    output:
        "results/lookalike/design.json",
    params:
        cfg=lambda wc: json.dumps(LA).replace("'", ""),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/lookalike_steps.py design {output} {input.mech} {input.temporal} "
        "{input.trees} '{params.cfg}'"


rule lookalike_shard:
    """Laplace log evidence of every candidate in shard i (candidates i::n) on every dataset (GitHub Actions)."""
    input:
        design="results/lookalike/design.json",
        code=["hsr/lookalike.py", "hsr/likelihood.py", "workflow/scripts/lookalike_steps.py"],
    output:
        "results/lookalike/shards/{i}of{n}.npz",
    params:
        n_starts=LA["n_starts"],
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/lookalike_steps.py shard {input.design} {output} {wildcards.i} "
        "{wildcards.n} {params.n_starts}"


rule lookalike_evidence:
    input:
        LA_SHARDS,


rule lookalike_report:
    input:
        design="results/lookalike/design.json",
        shards=LA_SHARDS,
        trees="results/grammar/hpyv/trees_mech.json",
        mech=expand("results/grammar/mechholdout_equal/{s}.json",
                    s=["folds", "ours", "fnprior", "hpy"] + [f"hpyv_{v}" for v in HPYV_VARIANTS]),
        temporal=expand(f"results/grammar/{LA_TRUN}/{{s}}.json",
                        s=["folds", "ours", "fnprior", "hpy"] + [f"hpyvt_{v}" for v in HPYV_VARIANTS]),
        code=["hsr/lookalike.py", "workflow/scripts/lookalike_steps.py"],
    output:
        md="results/grammar/lookalike.md",
        json="results/grammar/lookalike.json",
    params:
        variants=",".join(HPYV_VARIANTS),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/lookalike_steps.py report {output.md} {output.json} "
        "{input.design} {input.trees} results/grammar/mechholdout_equal results/grammar/{LA_TRUN} "
        "{params.variants} {input.shards}"


# ================================================= temporal hold-out (temporal_*)
# Test 3: train every prior only on models published before a cutoff year Y,
# score the forms of models published from Y on, split into forms already used
# before Y ("seen") and forms first used at or after Y ("novel").
#
#     snakemake --use-conda --cores 1 temporal
#
# Publication years: hsr.model_dates (records of BioModels, ModelDB, JWS
# fetched locally; EBI blocks GitHub-hosted runners). Folds: hsr.temporal.
# The scoring rules are the generic ones (grammar_scores, fnprior_scores,
# hpy_scores) plus copies of hpyv_scores / hpyv_table_run that use a tree
# file covering the temporal folds (results/grammar/temporal/trees.json).
TEMPORAL = config["temporal"]
TEMPORAL_RUNS = [f"temporal_{y}_{w}" for y in TEMPORAL["cutoffs"] for w in TEMPORAL["weightings"]]
TEMPORAL_CORPORA = (expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"] + NEW_CORPORA)
                    + ["hsr/data/corpus.json"])


rule temporal:
    input:
        "results/grammar/temporal.md",


rule model_dates_fetch:
    """Model records with publication years: BioModels curated and non-curated
    (EBI; run locally), ModelDB and JWS Online, one request per model of the
    committed corpora, <= 40 requests per minute per site. Records are cached
    under results/corpora/raw/dates/<source>/ with a manifest (URLs, sha256);
    delete the directory to refresh."""
    input:
        corpora=["hsr/data/corpus.json", "hsr/data/corpus_biomodels_nc.json", "hsr/data/corpus_modeldb.json",
                 "hsr/data/corpus_jws.json"],
    output:
        "results/corpora/raw/dates/manifest.json",
    params:
        raw="results/corpora/raw/dates",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python -m hsr.model_dates fetch {params.raw} hsr/data"


rule model_dates:
    """Publication year of every dated corpus model (committed): fetched records,
    the cached SABIO-RK export (publication years), PMR workspace and file
    names, allodb reference ids and the catalogues' references."""
    input:
        rec="results/corpora/raw/dates/manifest.json",
        sabiork="results/corpora/raw/sabiork/manifest.json",
        cellml="results/corpora/raw/cellml/manifest.json",
        corpora=TEMPORAL_CORPORA,
        cats=["hsr/data/sources/thermal_curves.csv", "hsr/data/sources/ecocurves_curves.csv",
              "hsr/data/sources/bio_catalogue.csv"],
        code="hsr/model_dates.py",
    output:
        "hsr/data/model_dates.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python -m hsr.model_dates build results/corpora/raw/dates results/corpora/raw/sabiork "
        "{input.cellml} hsr/data {output}"


rule temporal_folds:
    """Train on every source's models dated before the cutoff (plus the undated
    sources), test on the model-form pairs of models dated from the cutoff on."""
    input:
        gen="results/grammar/generalised.json",
        dates="hsr/data/model_dates.json",
        corpora=TEMPORAL_CORPORA,
        code=["hsr/temporal.py", "hsr/grammar_compare.py", "workflow/scripts/temporal_steps.py"],
    output:
        "results/grammar/temporal_{cutoff}_{weighting}/folds.json",
    wildcard_constraints:
        cutoff=r"\d{4}",
        weighting="pooled|equal",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/temporal_steps.py folds {input.gen} {input.dates} "
        "{wildcards.cutoff} {wildcards.weighting} {output}"


rule temporal_trees:
    """Every support/train/test form of the temporal folds coded as a tree (as hpyv_trees)."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=TEMPORAL_RUNS),
        code=["workflow/scripts/hpyv_trees.py", "hsr/treecode.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/temporal/trees.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_trees.py {output} {input.folds}"


rule temporal_hpyv_scores:
    """hpyv_scores on a temporal fold (source labels are stored in the fold;
    test forms are scored as a new, unseen source)."""
    input:
        folds="results/grammar/temporal_{trun}/folds.json",
        trees="results/grammar/temporal/trees.json",
        variant="results/grammar/hpyv/variants/{v}.json",
        code=["workflow/scripts/hpyv_score.py"] + HPYV_CODE,
    output:
        "results/grammar/temporal_{trun}/hpyvt_{v}.json",
    wildcard_constraints:
        trun=r"\d{4}_(pooled|equal)",
    params:
        sweeps=HPYV["sweeps"],
        keep=HPYV["keep"],
    conda:
        "envs/fnprior.yaml"
    shell:
        # the sources argument is unused when the fold carries train_labels
        "python workflow/scripts/hpyv_score.py {input.folds} {input.trees} {input.folds} {input.variant} {output} "
        "{params.sweeps} {params.keep}"


ruleorder: temporal_table_run > hpyv_table_run


rule temporal_table_run:
    input:
        folds="results/grammar/temporal_{trun}/folds.json",
        trees="results/grammar/temporal/trees.json",
        ours="results/grammar/temporal_{trun}/ours.json",
        fnp="results/grammar/temporal_{trun}/fnprior.json",
        hpy="results/grammar/temporal_{trun}/hpy.json",
        v=expand("results/grammar/temporal_{{trun}}/hpyvt_{v}.json", v=HPYV_VARIANTS),
        code="workflow/scripts/hpyv_table.py",
    output:
        json="results/grammar/temporal_{trun}/table_v.json",
        md="results/grammar/temporal_{trun}/table_v.md",
    wildcard_constraints:
        trun=r"\d{4}_(pooled|equal)",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_table.py {input.folds} {input.trees} {output.json} {output.md} "
        "{input.ours} {input.fnp} {input.hpy} {input.v}"


rule temporal_report:
    """Summary: raw log P per prior on all, seen and novel test forms, per cutoff and weighting."""
    input:
        dates="hsr/data/model_dates.json",
        tables=expand("results/grammar/{run}/table_v.json", run=TEMPORAL_RUNS),
        scores=expand("results/grammar/{run}/{s}.json", run=TEMPORAL_RUNS,
                      s=["ours", "fnprior", "hpy"] + [f"hpyvt_{v}" for v in HPYV_VARIANTS]),
        code=["workflow/scripts/temporal_steps.py", "hsr/temporal.py"],
    output:
        md="results/grammar/temporal.md",
        json="results/grammar/temporal.json",
    params:
        runs=" ".join(f"results/grammar/{r}" for r in TEMPORAL_RUNS),
        variants=",".join(HPYV_VARIANTS),
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/temporal_steps.py report {output.md} {output.json} {input.dates} "
        "{params.variants} {params.runs}"
