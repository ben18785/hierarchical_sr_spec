"""Reproducible analyses for hsr.

    snakemake --use-conda --cores 4                 # everything
    snakemake --use-conda --cores 4 grammar         # prior comparison only

Heavy fits run on GitHub Actions (.github/workflows/benchmark.yml); rules here
consume their artifacts by run ID (config/config.yaml) and build every table.
"""
import os

configfile: "config/config.yaml"

ROOT = os.path.abspath(os.path.join(workflow.basedir, ".."))
HSR_ENV = "envs/hsr.yaml"
GC = config["grammar_compare"]
SEEDS = GC["seeds"]


TRANSFER = ["curvelib", "sabiork", "cellml", "biocat"]


rule all:
    input:
        "results/grammar/table.md",
        expand("results/grammar/transfer_{name}/table.md", name=TRANSFER),


rule grammar:
    input:
        "results/grammar/loso.md",
        "results/grammar/table.md",
        expand("results/grammar/transfer_{name}/table.md", name=TRANSFER),


# ---------------------------------------------------------------- corpora
rule curvelib_eval:
    """Evaluate the R implementations (stats self-start models, nlraa, drc) at
    fixed random parameters; package versions are written alongside."""
    input:
        "hsr/data/sources/curve_libraries.csv",
    output:
        csv="results/corpora/curvelib_eval.csv",
        versions="results/corpora/curvelib_eval.csv.versions",
    params:
        rlib=config.get("r_lib", ""),
    shell:
        "Rscript workflow/scripts/curvelib_eval.R {input} {output.csv} '{params.rlib}'"


rule curvelib_corpus:
    """Verified, canonicalised corpus of curve-library forms (committed)."""
    input:
        src="hsr/data/sources/curve_libraries.csv",
        ev="results/corpora/curvelib_eval.csv",
        code=["workflow/scripts/curvelib_build.py", "hsr/grammar_compare.py", "hsr/canonical.py"],
    output:
        "hsr/data/corpus_curvelib.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/curvelib_build.py {input.src} {input.ev} {output}"


rule sabiork_fetch:
    """Snapshot of every SABIO-RK kinetic-law entry (export API, JSON; ~80
    requests at <= 40 per minute). The manifest records the date, URLs and
    sha256 of each page; delete results/corpora/raw/sabiork to refresh."""
    output:
        "results/corpora/raw/sabiork/manifest.json",
    params:
        raw="results/corpora/raw/sabiork",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py sabiork_fetch {params.raw}"


rule sabiork_corpus:
    """Rate laws reduced to generalised one-variable skeletons, one model per publication (committed)."""
    input:
        man="results/corpora/raw/sabiork/manifest.json",
        code=["hsr/corpus_sources.py", "hsr/corpus.py", "hsr/canonical.py", "hsr/grammar_compare.py"],
    output:
        "hsr/data/corpus_sabiork.json",
    params:
        raw="results/corpora/raw/sabiork",
    threads: 4
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py sabiork_build {params.raw} {output} {threads}"


rule cellml_fetch:
    """Snapshot of the CellML files of every Physiome Model Repository exposure
    (one archive per workspace at the exposed changeset; ~2 requests per
    exposure at <= 40 per minute). Delete results/corpora/raw/cellml to refresh."""
    output:
        "results/corpora/raw/cellml/manifest.json",
    params:
        raw="results/corpora/raw/cellml",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py cellml_fetch {params.raw}"


rule cellml_equations:
    """Equations of every CellML file of the snapshot (libcellml: parse, resolve
    imports locally, flatten, analyse, generate Python; one process per file)."""
    input:
        man="results/corpora/raw/cellml/manifest.json",
        code="workflow/scripts/cellml_extract.py",
    output:
        "results/corpora/cellml_equations.json",
    params:
        raw="results/corpora/raw/cellml",
    threads: 4
    conda:
        "envs/cellml.yaml"
    shell:
        "python workflow/scripts/cellml_extract.py all {params.raw} {output} {threads}"


rule cellml_corpus:
    """CellML equations reduced to generalised one-variable skeletons, one model per workspace (committed)."""
    input:
        eq="results/corpora/cellml_equations.json",
        code=["hsr/corpus_sources.py", "hsr/corpus.py", "hsr/canonical.py", "hsr/grammar_compare.py"],
    output:
        "hsr/data/corpus_cellml.json",
    threads: 4
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py cellml_build {input.eq} {output} {threads}"


rule biocat_eval:
    """Evaluate independent implementations (linpk, drc, frair, FSA, or the
    defining ODE with deSolve) of the curated catalogue's forms at fixed random
    parameters; package versions are written alongside."""
    input:
        src="hsr/data/sources/bio_catalogue.csv",
        code="workflow/scripts/biocat_eval.R",
    output:
        csv="results/corpora/biocat_eval.csv",
        versions="results/corpora/biocat_eval.csv.versions",
    params:
        rlib=config.get("r_lib", ""),
    shell:
        "Rscript workflow/scripts/biocat_eval.R {input.src} {output.csv} '{params.rlib}'"


rule biocat_corpus:
    """Verified, canonicalised corpus of the curated catalogue (committed)."""
    input:
        src="hsr/data/sources/bio_catalogue.csv",
        ev="results/corpora/biocat_eval.csv",
        code=["hsr/corpus_sources.py", "hsr/corpus.py", "hsr/canonical.py", "hsr/grammar_compare.py"],
    output:
        "hsr/data/corpus_biocat.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/corpus_sources.py catalogue_build {input.src} {input.ev} {output}"


LOSO = ["biomodels", "sabiork", "cellml", "curvelib", "biocat"]


rule loso_folds:
    """Leave one corpus out: train priors on the other sources (pooled or
    equally weighted), score the left-out source."""
    input:
        gen="results/grammar/generalised.json",
        corpora=expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"]) + ["hsr/data/corpus.json"],
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/loso_{test}_{weighting}/folds.json",
    wildcard_constraints:
        weighting="pooled|equal",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py loso {input.gen} {wildcards.test} "
        "{wildcards.weighting} {output}"


rule loso_table:
    input:
        expand("results/grammar/loso_{test}_{weighting}/table.md", test=LOSO, weighting=["pooled", "equal"]),
    output:
        "results/grammar/loso.md",
    shell:
        "for f in {input}; do echo \"## $(dirname $f | xargs basename)\"; cat $f; echo; done > {output}"


rule transfer_folds:
    input:
        gen="results/grammar/generalised.json",
        test="hsr/data/corpus_{name}.json",
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/transfer_{name}/folds.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py transfer {input.gen} {input.test} {output}"


rule biomodels_corpus:
    """BioModels kinetic-law corpus (hsr.corpus). EBI blocks GitHub-hosted
    runners, so this runs locally; downloads are cached under
    results/corpora/raw/biomodels and a manifest (sha256 per model) is written."""
    output:
        corpus="hsr/data/corpus.json",
        manifest="results/corpora/raw/biomodels/MANIFEST.json",
    params:
        cache="results/corpora/raw/biomodels",
        first=config.get("biomodels_first", 1),
        last=config.get("biomodels_last", 1100),
    conda:
        "envs/biomodels.yaml"
    shell:
        "PYTHONPATH={ROOT} python -m hsr.corpus build --out {output.corpus} --first {params.first} "
        "--last {params.last} --cache {params.cache} && "
        "PYTHONPATH={ROOT} python workflow/scripts/manifest.py {params.cache} {output.manifest}"


rule corpus_generalised:
    """Literal-free form of every corpus key, shipped with the package (used by --prior fnprior)."""
    input:
        corpus="hsr/data/corpus.json",
        code=["hsr/grammar_compare.py", "hsr/canonical.py", "hsr/fixed_prior.py"],
    output:
        "hsr/data/corpus_generalised.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python -c 'from hsr.fixed_prior import build_generalised; build_generalised()'"


rule generalised:
    """Literal-free generalisation of every corpus and candidate form (slow: sympy)."""
    input:
        corpus="hsr/data/corpus.json",
        candidates="hsr/data/candidates.json",
        code=["hsr/canonical.py"],
    output:
        "results/grammar/generalised.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py generalised {output}"


rule folds:
    input:
        gen="results/grammar/generalised.json",
        code=["hsr/grammar_compare.py", "workflow/scripts/grammar_steps.py"],
    output:
        "results/grammar/seed{seed}/folds.json",
    params:
        k=GC["k"],
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py folds {input.gen} {output} {params.k} {wildcards.seed}"


rule grammar_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        code="hsr/grammar_compare.py",
    output:
        "results/grammar/{run}/ours.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py ours {input.folds} {output}"


rule fnprior_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        code="workflow/scripts/fnprior_score.py",
    output:
        "results/grammar/{run}/fnprior.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/fnprior_score.py {input.folds} {output}"


rule hpy_scores:
    """Hierarchical Pitman-Yor model (hsr.hpy) on fnprior's tree events."""
    input:
        folds="results/grammar/{run}/folds.json",
        code=["workflow/scripts/hpy_score.py", "hsr/hpy.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/{run}/hpy.json",
    params:
        sweeps=config.get("hpy_sweeps", 20),
        keep=config.get("hpy_keep", 10),
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpy_score.py {input.folds} {output} {params.sweeps} {params.keep}"


rule grammar_table_run:
    input:
        folds="results/grammar/{run}/folds.json",
        ours="results/grammar/{run}/ours.json",
        fnp="results/grammar/{run}/fnprior.json",
        hpy="results/grammar/{run}/hpy.json",
    output:
        json="results/grammar/{run}/table.json",
        md="results/grammar/{run}/table.md",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/grammar_steps.py table {input.folds} {output.json} {output.md} "
        "{input.ours} {input.fnp} {input.hpy}"


rule grammar_table:
    input:
        expand("results/grammar/seed{seed}/table.md", seed=SEEDS),
    output:
        "results/grammar/table.md",
    shell:
        "for f in {input}; do echo \"## $(dirname $f | xargs basename)\"; cat $f; echo; done > {output}"


# ------------------------------------------- tree-prior variants (hpyv_*)
# Graphical/hierarchical Pitman-Yor priors and subtree adaptors over
# fnprior's tree coding (hsr.pyp, hsr.adaptor), scored on every comparison
# run both renormalised over the support and as raw log P(tree).
#
#     snakemake --use-conda --cores 4 hpyv
HPYV = config["hpyv"]
HPYV_VARIANTS = list(HPYV["variants"])
HPYV_RUNS = ([f"seed{s}" for s in SEEDS] + [f"transfer_{n}" for n in TRANSFER]
             + [f"loso_{t}_{w}" for t in LOSO for w in ("pooled", "equal")])
HPYV_CODE = ["hsr/treecode.py", "hsr/pyp.py", "hsr/adaptor.py", "hsr/treecheck.py", "hsr/fnprior_tools.py"]


rule hpyv:
    input:
        "results/grammar/hpy_variants.md",


rule hpyv_variant:
    """One variant's settings (from config) as a file, so that scores depend on it."""
    output:
        "results/grammar/hpyv/variants/{v}.json",
    params:
        spec=lambda wc: HPYV["variants"].get(wc.v, {}),
    run:
        import json
        with open(output[0], "w") as fh:
            json.dump({"name": wildcards.v, **params.spec}, fh, indent=1)


rule hpyv_trees:
    """Every support form coded as a tree (hsr.treecode); checks the events against fnprior's own coding."""
    input:
        folds=expand("results/grammar/{run}/folds.json", run=HPYV_RUNS),
        code=["workflow/scripts/hpyv_trees.py", "hsr/treecode.py", "hsr/fnprior_tools.py"],
    output:
        "results/grammar/hpyv/trees.json",
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_trees.py {output} {input.folds}"


rule hpyv_sources:
    """Model-form pairs of every corpus source (labels for the source-level hierarchy)."""
    input:
        gen="results/grammar/generalised.json",
        corpora=expand("hsr/data/corpus_{n}.json", n=["sabiork", "cellml", "curvelib", "biocat"]) + ["hsr/data/corpus.json"],
        code=["workflow/scripts/hpyv_sources.py", "hsr/grammar_compare.py"],
    output:
        "results/grammar/hpyv/sources.json",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_sources.py {input.gen} {output}"


rule hpyv_scores:
    input:
        folds="results/grammar/{run}/folds.json",
        trees="results/grammar/hpyv/trees.json",
        sources="results/grammar/hpyv/sources.json",
        variant="results/grammar/hpyv/variants/{v}.json",
        code=["workflow/scripts/hpyv_score.py"] + HPYV_CODE,
    output:
        "results/grammar/{run}/hpyv_{v}.json",
    wildcard_constraints:
        run="[^/]+",
    params:
        sweeps=HPYV["sweeps"],
        keep=HPYV["keep"],
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_score.py {input.folds} {input.trees} {input.sources} {input.variant} {output} "
        "{params.sweeps} {params.keep}"


rule hpyv_table_run:
    input:
        folds="results/grammar/{run}/folds.json",
        trees="results/grammar/hpyv/trees.json",
        ours="results/grammar/{run}/ours.json",
        fnp="results/grammar/{run}/fnprior.json",
        hpy="results/grammar/{run}/hpy.json",
        v=expand("results/grammar/{{run}}/hpyv_{v}.json", v=HPYV_VARIANTS),
        code="workflow/scripts/hpyv_table.py",
    output:
        json="results/grammar/{run}/table_v.json",
        md="results/grammar/{run}/table_v.md",
    wildcard_constraints:
        run="[^/]+",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_table.py {input.folds} {input.trees} {output.json} {output.md} "
        "{input.ours} {input.fnp} {input.hpy} {input.v}"


rule hpyv_calib:
    """Size calibration and properness of a prior trained on all BioModels forms (forward samples)."""
    input:
        folds="results/grammar/transfer_sabiork/folds.json",
        trees="results/grammar/hpyv/trees.json",
        variant="results/grammar/hpyv/variants/{v}.json",
        code=["workflow/scripts/hpyv_calib.py"] + HPYV_CODE,
    output:
        "results/grammar/hpyv/calib_{v}.json",
    params:
        sweeps=HPYV["sweeps"],
        keep=HPYV["keep"],
        n=HPYV["calib_samples"],
    conda:
        "envs/fnprior.yaml"
    shell:
        "python workflow/scripts/hpyv_calib.py {input.folds} {input.trees} {input.variant} {output} "
        "{params.sweeps} {params.keep} {params.n}"


rule hpyv_report:
    input:
        tables=expand("results/grammar/{run}/table_v.json", run=HPYV_RUNS),
        scores=expand("results/grammar/{run}/hpyv_{v}.json", run=HPYV_RUNS, v=HPYV_VARIANTS),
        calib=expand("results/grammar/hpyv/calib_{v}.json", v=HPYV_VARIANTS + ["fnprior_kn"]),
        trees="results/grammar/hpyv/trees.json",
        notes="workflow/notes/hpy_variants.md",
        code="workflow/scripts/hpyv_report.py",
    output:
        "results/grammar/hpy_variants.md",
    conda:
        HSR_ENV
    shell:
        "PYTHONPATH={ROOT} python workflow/scripts/hpyv_report.py {output} {input.trees} --notes {input.notes} "
        "--tables {input.tables} --scores {input.scores} --calib {input.calib}"
